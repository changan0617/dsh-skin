{
  "name": "dsh-skin",
  "version": "1.1.0",
  "description": "DeepSeek Harness 首页风格聊天背景皮肤插件（WebGL 流体 + 点线网格 + 数字点云鲸鱼），可随时启用/停用",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.7-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/changan0617/dsh-skin.git"
  },
  "homepage": "https://github.com/changan0617/dsh-skin",
  "license": "MIT"
}
